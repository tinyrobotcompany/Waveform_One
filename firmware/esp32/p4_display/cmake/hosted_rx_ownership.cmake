# Backport the upstream RX ownership fix without changing the C6 protocol or
# editing downloaded managed components. Fail closed if the pinned source moves.
# https://github.com/espressif/esp-hosted-mcu/blob/main/docs/changelog.md (2.11.0)
function(waveform_fix_hosted_rx target component_dir owner_include)
    set(original "${component_dir}/host/drivers/transport/sdio/sdio_drv.c")
    file(SHA256 "${original}" source_hash)
    if(NOT source_hash STREQUAL "9868f97b7c68e5d8f1a3ac904dc6922b8ba0cc160c28c6a1402cd5c4147a652a")
        message(FATAL_ERROR "ESP-Hosted SDIO source changed; review the RX ownership backport")
    endif()
    file(READ "${original}" source)
    set(before "if (unlikely(ret))\n\t\t\t\t\tHOSTED_FREE(copy_payload);")
    string(FIND "${source}" "${before}" found)
    if(found LESS 0)
        message(FATAL_ERROR "ESP-Hosted RX ownership patch location missing")
    endif()
    string(REPLACE "${before}" "if (esp_hosted_rx_caller_frees(ret))\n\t\t\t\t\tHOSTED_FREE(copy_payload);" source "${source}")
    string(REPLACE "#include \"string.h\"" "#include \"string.h\"\n#include \"hosted_rx_ownership.h\"" source "${source}")
    set(patched "${CMAKE_CURRENT_BINARY_DIR}/sdio_drv_rx_ownership.c")
    file(WRITE "${patched}" "${source}")
    get_target_property(sources ${target} SOURCES)
    set(replaced FALSE)
    set(fixed_sources)
    foreach(input IN LISTS sources)
        get_filename_component(absolute "${input}" ABSOLUTE BASE_DIR "${component_dir}")
        if(absolute STREQUAL original)
            list(APPEND fixed_sources "${patched}")
            set(replaced TRUE)
        else()
            list(APPEND fixed_sources "${input}")
        endif()
    endforeach()
    if(NOT replaced)
        message(FATAL_ERROR "ESP-Hosted SDIO target source missing; ownership fix was not applied")
    endif()
    set_property(TARGET ${target} PROPERTY SOURCES ${fixed_sources})
    target_include_directories(${target} PRIVATE "${owner_include}")
endfunction()
